{
  "regions": ["icn1"],
  "crons": [
    { "path": "/api/crawl-discounts?fn=flyers&action=cron", "schedule": "0 22 * * *" },
    {
      "path": "/api/pending-products?action=cron",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/generate-content?daily=1",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/crawl-discounts?action=cron",
      "schedule": "30 21 * * *"
    }
  ],
  "images": {
    "sizes": [384],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "bizimg.giftishow.com"
      }
    ],
    "minimumCacheTTL": 2592000,
    "formats": ["image/webp"]
  },
  "functions": {
    "api/pending-products.js": {
      "maxDuration": 300
    },
    "api/generate-content.ts": {
      "maxDuration": 60
    },
    "api/crawl-discounts.js": {
      "maxDuration": 60
    },
    "api/kamis.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/admob-reward",
      "destination": "/api/giftishow"
    },
    {
      "source": "/api/flyers",
      "destination": "/api/crawl-discounts?fn=flyers"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/site-content?sitemap=1"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/download",
      "destination": "/download.html"
    },
    {
      "source": "/guide",
      "destination": "/guide/index.html"
    },
    {
      "source": "/guide/:slug",
      "destination": "/guide/:slug/index.html"
    },
    {
      "source": "/auth-callback",
      "destination": "/auth-callback.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/delete-account",
      "destination": "/delete-account.html"
    },
    {
      "source": "/editorial-policy",
      "destination": "/editorial-policy.html"
    },
    {
      "source": "/google7c65654b946a2f3b",
      "destination": "/google7c65654b946a2f3b.html"
    },
    {
      "source": "/location-policy",
      "destination": "/location-policy.html"
    },
    {
      "source": "/presentation",
      "destination": "/presentation.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/location",
      "destination": "/location-policy.html"
    },
    {
      "source": "/product/:id",
      "destination": "/api/site-content?page=product&id=:id"
    },
    {
      "source": "/((?!api(?:/|$)|assets/|guide(?:/|$)|ads\\.txt|app-ads\\.txt|robots\\.txt|sitemap\\.xml).*)",
      "has": [{ "type": "host", "value": "pc.sinsangpick.kr" }],
      "destination": "/pc.html"
    },
    {
      "source": "/((?!api(?:/|$)|assets/|guide(?:/|$)|ads\\.txt|app-ads\\.txt|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    },
    {
      "source": "/app-ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "tab"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "p"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/beauty",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
