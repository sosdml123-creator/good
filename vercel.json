{
  "regions": ["icn1"],
  "crons": [
    { "path": "/api/flyers?action=cron", "schedule": "0 22 * * *" },
    {
      "path": "/api/pending-products?action=cron",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/generate-content?daily=1",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/crawl-discounts?action=cron",
      "schedule": "30 21 * * *"
    }
  ],
  "images": {
    "sizes": [384],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "bizimg.giftishow.com"
      }
    ],
    "minimumCacheTTL": 2592000,
    "formats": ["image/webp"]
  },
  "functions": {
    "api/pending-products.js": {
      "maxDuration": 300
    },
    "api/generate-content.ts": {
      "maxDuration": 60
    },
    "api/crawl-discounts.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/admob-reward",
      "destination": "/api/giftishow"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/site-content?sitemap=1"
    },
    {
      "source": "/product/:id",
      "destination": "/api/site-content?page=product&id=:id"
    },
    {
      "source": "/((?!api/|app-ads\\.txt|robots\\.txt|sitemap\\.xml).*)",
      "has": [{ "type": "host", "value": "pc.sinsangpick.kr" }],
      "destination": "/pc.html"
    },
    {
      "source": "/((?!api/|app-ads\\.txt|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    },
    {
      "source": "/app-ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
