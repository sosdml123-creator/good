{
  "crons": [
    {
      "path": "/api/pending-products?action=cron",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/generate-content?daily=1",
      "schedule": "0 22 * * *"
    }
  ],
  "images": {
    "sizes": [384],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "bizimg.giftishow.com"
      }
    ],
    "minimumCacheTTL": 2592000,
    "formats": ["image/webp"]
  },
  "functions": {
    "api/generate-content.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|app-ads\\.txt|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/app-ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
