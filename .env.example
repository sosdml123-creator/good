# Supabase Configuration for SinSangPick (신상픽)
# Supabase 대시보드 (https://supabase.com/dashboard) -> Project Settings -> API에서 복사하여 붙여넣으세요.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# NAVER Cloud Platform API Gateway (NAVER API HUB)
VITE_NAVER_CLIENT_ID=your-ncp-client-id
VITE_NAVER_CLIENT_SECRET=your-ncp-client-secret
NAVER_CLIENT_ID=your-ncp-client-id
NAVER_CLIENT_SECRET=your-ncp-client-secret
