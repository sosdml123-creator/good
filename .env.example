# Supabase Configuration for SinSangPick (신상픽)
# Supabase 대시보드 (https://supabase.com/dashboard) -> Project Settings -> API에서 복사하여 붙여넣으세요.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin API Security (서버리스 관리자 기능 보호용 시크릿)
ADMIN_API_KEY=your-admin-secret-key-here

# NAVER Cloud Platform API Gateway (NAVER API HUB / Search API)
# ⚠️ Client Secret은 VITE_ 접두사를 붙이지 마세요 (서버 전용)
NAVER_CLIENT_ID=your-ncp-client-id
NAVER_CLIENT_SECRET=your-ncp-client-secret
# 식품안전나라 Open API 인증키 (신제품 수집: 품목제조보고 I1250, 원재료 C002)
FOODSAFETY_API_KEY=your-foodsafetykorea-key

# NAVER Developers Open API (데이터랩 / 쇼핑 검색 백업용, 선택)
NAVER_OPENAPI_CLIENT_ID=your-naver-openapi-client-id
NAVER_OPENAPI_CLIENT_SECRET=your-naver-openapi-client-secret

# NAVER Maps (NCP Maps Application: Dynamic Map + Reverse Geocoding, /api/naver?type=nearby_stores)
# ⚠️ VITE_ 접두사를 붙이지 마세요 (서버 전용). 지도 표시용 Client ID는 공개 값이라 src/services/naverMap.ts 에 있습니다.
NAVER_MAP_CLIENT_ID=your-ncp-maps-client-id
NAVER_MAP_CLIENT_SECRET=your-ncp-maps-client-secret

# Food Nutrition Open API (식약처 식품영양성분DB)
# ⚠️ VITE_ 접두사를 붙이지 마세요 (서버 전용, /api/nutrition 프록시에서만 사용)
FOOD_NUTRITION_API_KEY=your-food-nutrition-api-key

# Apple Push Notification service (iOS 기기 푸시, /api/send-fcm)
# Apple Developer -> Certificates, Identifiers & Profiles -> Keys 에서 APNs Auth Key(.p8) 발급
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apple-team-id
# .p8 파일 내용 전체 (-----BEGIN PRIVATE KEY----- 포함)
APNS_PRIVATE_KEY=your-apns-p8-file-contents

# KAMIS Open API (농수산물유통정보 - aT 한국농수산식품유통공사)
KAMIS_API_KEY=your-kamis-cert-key-here
VITE_KAMIS_API_KEY=your-kamis-cert-key-here
KAMIS_API_ID=your-kamis-id-here
VITE_KAMIS_API_ID=your-kamis-id-here

# Anthropic API (인스타그램 카드뉴스 생성 + 매일 아침 자동 콘텐츠: /api/generate-content)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Admin AI Agent Hub (/api/ai-agents, 선택)
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Vercel Cron Job Security
CRON_SECRET=your-cron-secret-key-here

# 기프티쇼 비즈 API (KT alpha e쿠폰 포인트 교환, /api/giftishow)
# ⚠️ VITE_ 접두사를 붙이지 마세요 (서버 전용)
GIFTISHOW_AUTH_CODE=your-giftishow-auth-key
GIFTISHOW_AUTH_TOKEN=your-giftishow-token-key
# 기프티쇼 비즈 회원 ID / 등록된 발신번호 ('-' 제외) — 둘 다 있어야 교환(발급)이 켜집니다
GIFTISHOW_USER_ID=your-giftishow-biz-login-id
GIFTISHOW_CALLBACK_NO=0212345678
# 안전 한도 (선택, 1P = 1원): 상품 최고가 / 1인 일일 한도 / 전체 일일 한도
GIFTISHOW_MAX_PRICE=30000
GIFTISHOW_USER_DAILY_LIMIT=30000
GIFTISHOW_GLOBAL_DAILY_LIMIT=300000

# 보상형 광고 포인트 적립 (AdMob 서버 간 확인 콜백: https://www.sinsangpick.kr/api/admob-reward)
# 광고 단위 ID 의 '/' 뒤 숫자 (여러 개는 쉼표로 구분) — 비어 있으면 적립하지 않습니다
ADMOB_REWARD_AD_UNITS=1234567890
# 1회 적립 포인트 / 1인 하루 적립 횟수 (선택)
ADMOB_REWARD_POINTS=2
ADMOB_REWARD_DAILY_LIMIT=10
